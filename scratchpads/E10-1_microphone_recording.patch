+// AnAudioTrackRecordsTheMicrophoneTests.swift
+// Restructure E10-1 (founder 2026-10-04: „Audio-Eingang soll Aufnahme, Sampling und Analyse
+// ermöglichen; Mikrofonzugriff wird ausdrücklich aktiviert.")
+//
+// The smallest complete path for the microphone: arm an audio track (the permission is asked at
+// the arm switch), press Record, and `MicTakeRecorder` records the take into `Media/Audio`; Stop
+// — or the piece's end — lands it as a part on that track through the existing take commit.
+//
+// WHAT KIND OF GREEN THIS IS (Tests/CISmoke/CLAUDE.md §1):
+//   · END-TO-END BEHAVIOUR (claim 5) — `RecordTake.canArmAudio` and `RecordTake.plan` are pure
+//     `nonisolated` value functions: one microphone stream, a second armed audio track blocks
+//     Record by name, and without a recorder an armed audio track stays out of the plan.
+//   · SOURCE-TEXT SCAN (claims 1–4, 6–8) — the recorder needs a device microphone and the arm
+//     switch is a `View`; neither can run here. What the scans pin is the #299 route law (every
+//     claim has a release on every exit), the plist pairing, the ONE place each permission call
+//     sits, the engine graph staying input-free, and the failure reaching the button.
+//   · DEVICE PROBE, OPEN — the prompt appears, a sung take lands and plays in time, a Bluetooth
+//     route stays stereo: G9 in `docs/dev/FOUNDER_INBOX.md`.
+//
+// HONEST GRADING against the parent (eaf8f7ca6, §3): the file does NOT compile there —
+// claim 5 calls `RecordTake.canArmAudio` and the three-argument `RecordTake.plan`, both created by
+// this commit — so no assertion has a verdict on the parent (ONE absence, #486). Every claim is a
+// FORWARD guard, transcribed in Python against the worktree. Mutants driven, each red for its
+// named reason: the plist key removed while the owner case stays (claim 1), one release dropped
+// from a `start` failure branch (claim 2), `prepare()` moved below `armed = true` (claim 3), a
+// second `MicAccess.request()` caller (claim 4), `.inputNode` in the recorder (claim 6), the
+// `audioTakeProblem` assignment removed from `finishWithAudio` (claim 7), the song-end branch
+// back on `recorder.finish(` directly (claim 8). COUNTERWEIGHTS (#343): claim 5's no-recorder
+// plan, claim 4's Settings door, claim 6's two `installTap` sites that tap the app's OWN output.
+//
+// `Tests/CISmoke` is the blocking bundle.
+
+import Foundation
+import XCTest
+@testable import Echoelmusic
+
+final class AnAudioTrackRecordsTheMicrophoneTests: XCTestCase {
+
+    private static let recorderFile = "Sources/Echoelmusic/Audio/MicTakeRecorder.swift"
+    private static let configuration = "Sources/Echoelmusic/Audio/AudioConfiguration.swift"
+    private static let controller = "Sources/Echoelmusic/Core/RecordController.swift"
+    private static let door = "Sources/Echoelmusic/Studio/RecordTakeControls.swift"
+    private static let plist = "Resources/iOS/Info.plist"
+
+    // MARK: 1 — the owner case and the permission string move together
+
+    /// iOS ends the app when a record category is activated without the usage string. The owner
+    /// case is what makes the route claimable at all, so the two are pinned as a pair.
+    func testTheRouteOwnerAndThePermissionStringArePresentTogether() throws {
+        let config = try code(Self.configuration)
+        let plist = try raw(Self.plist)
+        XCTAssertTrue(config.contains("case audioTrack"), "the microphone's route owner")
+        XCTAssertTrue(plist.contains("<key>NSMicrophoneUsageDescription</key>"), """
+            `RecordRouteOwner` has a case, so the route can be raised to `.playAndRecord`, but \
+            \(Self.plist) no longer carries NSMicrophoneUsageDescription — iOS terminates the app \
+            the first time a take starts. Restore the key in the SAME commit.
+            """)
+    }
+
+    // MARK: 2 — every claim of the route has a release on every exit (#299)
+
+    func testEveryClaimInTheRecorderIsReleasedOnEveryExit() throws {
+        let recorder = try code(Self.recorderFile)
+        let claim = "try AudioConfiguration.claimRecordRoute(.audioTrack)"
+        let release = "try? AudioConfiguration.releaseRecordRoute(.audioTrack)"
+
+        let start = try body(of: "func start()", in: recorder)
+        let afterClaim = try XCTUnwrap(start.range(of: claim), "start claims the route")
+        let tail = String(start[afterClaim.upperBound...])
+        XCTAssertEqual(count("return", in: tail), count(release, in: tail), """
+            `MicTakeRecorder.start` has an exit after the route claim that does not give the \
+            route back. #299: one unbalanced claim holds the phone in `.playAndRecord` for the \
+            rest of the session.
+            """)
+        XCTAssertEqual(count(release, in: tail), 3, "the three failure branches after the claim")
+
+        let prepare = try body(of: "func prepare() -> Bool", in: recorder)
+        XCTAssertEqual(count(claim, in: prepare), 1)
+        let caught = try XCTUnwrap(prepare.range(of: "} catch {"), "prepare's failure branch")
+        XCTAssertTrue(prepare[caught.upperBound...].contains(release), "a failed prepare releases")
+
+        let stop = try body(of: "func stop() async -> (url: URL, seconds: Double)?", in: recorder)
+        XCTAssertEqual(count(release, in: stop), 2, "stop releases whether or not it was recording")
+        XCTAssertEqual(count("routeHeld = false", in: stop), 2)
+        XCTAssertFalse(stop.contains(claim), "stop never claims")
+        XCTAssertEqual(count(claim, in: recorder), 2, "prepare and start are the only claims")
+    }
+
+    // MARK: 3 — the route is raised when Record is pressed, before the music starts
+
+    func testTheRouteIsPreparedAtArmBeforeTheTakeStarts() throws {
+        let controller = try code(Self.controller)
+        let arm = try body(of: "public func arm()", in: controller)
+        let prepare = try XCTUnwrap(arm.range(of: "audioRecorder.prepare()"), "arm prepares the microphone")
+        let armed = try XCTUnwrap(arm.range(of: "armed = true"), "arm arms")
+        XCTAssertLessThan(prepare.lowerBound, armed.lowerBound, """
+            The record route must be raised in `arm()`, before the transport starts: raising the \
+            category on a running engine restarts it, and that dropout would land on bar 1.
+            """)
+        let step = try body(of: "private func onStep(_ pos: TransportPosition)", in: controller)
+        XCTAssertTrue(step.contains("if audioPrepared, let audioRecorder,"),
+                      "the take starts the microphone only when arm prepared it")
+        XCTAssertEqual(count("releasePreparedMicrophone()", in: controller), 3,
+                       "the declaration plus cancel and the not-recording stop")
+        let cancel = try body(of: "public func cancel()", in: controller)
+        XCTAssertTrue(cancel.contains("releasePreparedMicrophone()"), "a cancelled arm gives the route back")
+        XCTAssertTrue(cancel.contains("try? FileManager.default.removeItem(at: dropped.url)"),
+                      "a cancelled take's file is not kept")
+    }
+
+    // MARK: 4 — the permission is asked in ONE place, and refusal has a way back
+
+    func testThePermissionIsAskedAtTheArmSwitchOnly() throws {
+        XCTAssertEqual(try filesUnderSources(containing: "MicAccess.request()"), ["Studio/RecordTakeControls.swift"])
+        XCTAssertEqual(try filesUnderSources(containing: "requestRecordPermission"), ["Audio/MicTakeRecorder.swift"])
+        XCTAssertEqual(try filesUnderSources(containing: "AVAudioRecorder("), ["Audio/MicTakeRecorder.swift"],
+                       "one microphone recorder")
+        let door = try code(Self.door)
+        XCTAssertTrue(door.contains("private func armWithMicrophone()"))
+        XCTAssertTrue(door.contains("UIApplication.openSettingsURLString"),
+                      "COUNTERWEIGHT: a refused permission offers the way to Settings")
+    }
+
+    // MARK: 5 — one microphone stream (END-TO-END)
+
+    func testOneAudioTrackRecordsAtATime() {
+        var first = TimelineLane(name: "Audio 1", kind: .audio)
+        var second = TimelineLane(name: "Audio 2", kind: .audio)
+        let keys = TimelineLane(name: "Keys", kind: .midi)
+        XCTAssertTrue(RecordTake.isAudioTrack(first.id, in: TimelineDocument(lanes: [first], regions: [])))
+        XCTAssertFalse(RecordTake.isAudioTrack(keys.id, in: TimelineDocument(lanes: [keys], regions: [])))
+
+        first.isArmed = true
+        var doc = TimelineDocument(lanes: [first, second, keys], regions: [])
+        XCTAssertTrue(RecordTake.canArmAudio(first.id, in: doc))
+        XCTAssertFalse(RecordTake.canArmAudio(second.id, in: doc), "a second track would record nothing")
+        XCTAssertFalse(RecordTake.canArmAudio(keys.id, in: doc), "a MIDI track is not a microphone track")
+
+        second.isArmed = true
+        doc = TimelineDocument(lanes: [first, second, keys], regions: [])
+        let plan = RecordTake.plan(in: doc, voiceCapacity: 4, recordsAudio: true)
+        XCTAssertEqual(plan.armable, [first.id])
+        XCTAssertEqual(plan.foreign, ["Audio 2"], "the second armed audio track blocks Record by name")
+
+        // COUNTERWEIGHT: without a recorder an armed audio track records nothing and stays out.
+        let none = RecordTake.plan(in: doc, voiceCapacity: 4, recordsAudio: false)
+        XCTAssertEqual(none.armable, [])
+        XCTAssertEqual(none.foreign, [])
+    }
+
+    // MARK: 6 — the playback graph gains no input node
+
+    func testTheEngineGraphStaysFreeOfAnInputNode() throws {
+        let recorder = try code(Self.recorderFile)
+        for engineInput in [".inputNode", "installTap(", "AVAudioEngine"] {
+            XCTAssertFalse(recorder.contains(engineInput), """
+                `MicTakeRecorder` reaches into the engine graph (`\(engineInput)`). The crash family \
+                that took the old audio input down sat at the engine's input node; this recorder \
+                stays outside the graph on purpose.
+                """)
+        }
+        XCTAssertEqual(try filesUnderSources(containing: ".inputNode"), [], "no engine input node anywhere")
+        XCTAssertEqual(try filesUnderSources(containing: "installTap(onBus:"),
+                       ["Audio/AudioEngine.swift", "Audio/RetroCapture.swift"],
+                       "COUNTERWEIGHT: the two taps that exist record the app's OWN output")
+    }
+
+    // MARK: 7 — a failed take is said at the button
+
+    func testAMicrophoneFailureReachesTheButton() throws {
+        let controller = try code(Self.controller)
+        let finish = try body(of: "func finishWithAudio(", in: controller)
+        XCTAssertTrue(finish.contains("audioTakeProblem = audioRecorder.lastFailure"),
+                      "a take without a recording says so")
+        XCTAssertTrue(try code(Self.door).contains("recorder.audioTakeProblem"),
+                      "the Record door shows the microphone's failure")
+        let recorder = try code(Self.recorderFile)
+        XCTAssertTrue(recorder.contains("guard seconds.isFinite, seconds > 0.05 else {"),
+                      "an empty recording is removed, not placed")
+    }
+
+    // MARK: 8 — Stop and the piece's end finish the take the same way
+
+    func testTheSongEndFinishesTheMicrophoneLegToo() throws {
+        let controller = try code(Self.controller)
+        let step = try body(of: "private func onStep(_ pos: TransportPosition)", in: controller)
+        XCTAssertTrue(step.contains("finishTake(atTick: end)"), """
+            The song-end stop no longer goes through `finishTake`. A take with a microphone leg \
+            would then commit without waiting for the file, or run on past the end of the piece.
+            """)
+        let stop = try body(of: "private func commitOnStop()", in: controller)
+        XCTAssertTrue(stop.contains("finishTake(atTick: lastTick)"))
+        XCTAssertEqual(count("recorder.finish(", in: controller), 2,
+                       "finishTake's MIDI-only branch and finishWithAudio — no third path")
+    }
+
+    // MARK: - helpers
+
+    private func repoRoot() -> URL {
+        var url = URL(fileURLWithPath: #filePath)
+        for _ in 0..<3 { url.deleteLastPathComponent() }
+        return url
+    }
+
+    private func raw(_ relative: String) throws -> String {
+        let file = repoRoot().appendingPathComponent(relative)
+        guard FileManager.default.fileExists(atPath: file.path) else {
+            throw XCTSkip("\(relative) not on disk — this run has no source tree")
+        }
+        return try String(contentsOf: file, encoding: .utf8)
+    }
+
+    private func code(_ relative: String) throws -> String {
+        SourceText.codeOnly(try raw(relative))
+    }
+
+    private func count(_ needle: String, in text: String) -> Int {
+        text.components(separatedBy: needle).count - 1
+    }
+
+    /// The brace-matched body of the FIRST declaration starting with `signature` (#408: no
+    /// fixed window — this repo writes long comment blocks, and `codeOnly` keeps them as lines).
+    private func body(of signature: String, in text: String) throws -> String {
+        let head = try XCTUnwrap(text.range(of: signature), "`\(signature)` not found")
+        let rest = text[head.upperBound...]
+        let open = try XCTUnwrap(rest.firstIndex(of: "{"), "`\(signature)` has no body")
+        var depth = 0
+        var index = open
+        while index < rest.endIndex {
+            switch rest[index] {
+            case "{": depth += 1
+            case "}":
+                depth -= 1
+                if depth == 0 { return String(rest[open...index]) }
+            default: break
+            }
+            index = rest.index(after: index)
+        }
+        XCTFail("`\(signature)` body is not closed")
+        return ""
+    }
+
+    private func filesUnderSources(containing needle: String) throws -> [String] {
+        let root = repoRoot().appendingPathComponent("Sources/Echoelmusic")
+        guard let walker = FileManager.default.enumerator(atPath: root.path) else {
+            throw XCTSkip("cannot enumerate Sources/Echoelmusic — refusing to report a green it did not earn")
+        }
+        var hits: [String] = []
+        for case let relative as String in walker where relative.hasSuffix(".swift") {
+            guard let text = try? String(contentsOf: root.appendingPathComponent(relative), encoding: .utf8)
+            else { continue }
+            if SourceText.codeOnly(text).contains(needle) { hits.append(relative) }
+        }
+        return hits.sorted()
+    }
+}
