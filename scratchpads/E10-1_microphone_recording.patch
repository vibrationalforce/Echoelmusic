@@ -0,0 +1,202 @@
+// MicTakeRecorder.swift
+// Echoel — Restructure E10-1 (founder 2026-10-04: „Audio-Eingang soll Aufnahme, Sampling und
+// Analyse ermöglichen; Mikrofonzugriff wird ausdrücklich aktiviert.")
+//
+// The ONE microphone owner: records an armed audio track for the span of one take, into a
+// file in the media library (`Media/Audio`), and hands it to `RecordController`, which lands it
+// as a part through the existing take commit (`TakeRecorder.captureAudio`).
+//
+// ⭐ WHY `AVAudioRecorder` AND NOT THE ENGINE'S INPUT NODE. The audio input that #1302 deleted
+// tapped `AVAudioEngine.inputNode`, and its crash family (`isInputConnToConverter`, seven device
+// logs, never named) sat exactly there. `AVAudioRecorder` reads the session input on its own,
+// outside the playback graph — so the graph that makes the music gains no node, and the family
+// that took the old input down has nothing to attach to. The cost, stated: no live monitoring
+// and no effects on the input; the take is the raw microphone (headphones recommended).
+//
+// ⚠️ THE RECORD ROUTE IS CLAIMED HERE AND ONLY HERE (`RecordRouteOwner.audioTrack`), and every
+// exit that claimed it releases it — #299: an unbalanced claim held the phone in `.playAndRecord`
+// for the rest of the session. `AnAudioTrackRecordsTheMicrophoneTests` counts the pairs.
+// ⭐ IT IS CLAIMED WHEN RECORD IS PRESSED (`prepare`), BEFORE THE MUSIC STARTS. Raising the
+// category on a running engine makes iOS reconfigure it (`AudioEngine`'s configuration-change
+// watchdog restarts it); done on the first step of the take, that restart would land on bar 1 —
+// a dropout at the downbeat of the very recording. `start` claims again (a Set insert and a
+// skipped raise, both harmless) so a recorder used without `prepare` still holds the route.
+// `stop` releases whether or not a file was ever written, so an arm that never became a take
+// gives the route back too.
+// ⚠️ `NSMicrophoneUsageDescription` came back in the SAME commit as the owner case — iOS ends
+// the app when a record category is activated without it (`EveryPermissionPromptHasACapabilityTests`).
+//
+// Breadcrumbs stand BEFORE the step they announce (the ladder law, #859–#862b).
+//
+// NEEDS-FOUNDER-VERIFY: G9 — arm an audio track, Record, sing or play into the phone, Stop: the
+// recording is a new part on that track and a file in the library, and it plays back in time.
+
+#if canImport(AVFoundation)
+import AVFoundation
+import Foundation
+
+/// Whether the app may use the microphone, as the system reports it.
+enum MicAccess: Equatable, Sendable {
+    case granted, denied, undetermined
+
+    static var current: MicAccess {
+        #if os(iOS)
+        switch AVAudioApplication.shared.recordPermission {
+        case .granted: return .granted
+        case .denied: return .denied
+        default: return .undetermined
+        }
+        #else
+        return .denied
+        #endif
+    }
+
+    /// Asks once; the system shows its prompt only while the answer is undetermined.
+    static func request() async -> Bool {
+        #if os(iOS)
+        return await AVAudioApplication.requestRecordPermission()
+        #else
+        return false
+        #endif
+    }
+}
+
+@MainActor
+final class MicTakeRecorder: AudioTakeRecording {
+
+    private var recorder: AVAudioRecorder?
+    private var file: URL?
+    /// The record route is held by this recorder (claimed in `prepare` or `start`, given back in
+    /// `stop`). Only to keep a stop that had nothing to release from writing route breadcrumbs.
+    private var routeHeld = false
+    private(set) var lastFailure: String?
+
+    /// WAV, 24-bit, 48 kHz, mono: the library format every audio part already plays
+    /// (`AudioLanePlayer` reads it through `AVAudioFile`), lossless for sampling and analysis.
+    /// Computed, not stored: a `[String: Any]` is not `Sendable`, so a stored static would be a
+    /// shared mutable global to the Swift 6 checker (the #1402 shape).
+    static var settings: [String: Any] { [
+        AVFormatIDKey: kAudioFormatLinearPCM,
+        AVSampleRateKey: 48_000,
+        AVNumberOfChannelsKey: 1,
+        AVLinearPCMBitDepthKey: 24,
+        AVLinearPCMIsFloatKey: false,
+        AVLinearPCMIsBigEndianKey: false,
+    ] }
+
+    /// "Recording 2026-10-04 14.05.33" — readable in the library and on the part.
+    static func fileBase(at date: Date) -> String {
+        let format = DateFormatter()
+        format.locale = Locale(identifier: "en_US_POSIX")
+        format.dateFormat = "yyyy-MM-dd HH.mm.ss"
+        return "Recording " + format.string(from: date)
+    }
+
+    func prepare() -> Bool {
+        lastFailure = nil
+        guard MicAccess.current == .granted else {
+            EchoelCrashLog.breadcrumb("mic take: prepare REFUSED - no microphone permission")
+            lastFailure = String(localized: "Echoel may not use the microphone. Allow it in Settings, then record again.")
+            return false
+        }
+        guard !routeHeld else { return true }
+        EchoelCrashLog.breadcrumb("mic take: prepare 1/1 - claim route")
+        do {
+            try AudioConfiguration.claimRecordRoute(.audioTrack)
+            routeHeld = true
+            return true
+        } catch {
+            EchoelCrashLog.breadcrumb("mic take: prepare FAILED - route: \(error.localizedDescription)")
+            try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+            lastFailure = String(localized: "The microphone could not be opened. Close other apps that use it and record again.")
+            return false
+        }
+    }
+
+    func start() {
+        guard recorder == nil else { return }
+        lastFailure = nil
+        guard MicAccess.current == .granted else {
+            EchoelCrashLog.breadcrumb("mic take: start REFUSED - no microphone permission")
+            lastFailure = String(localized: "Echoel may not use the microphone. Allow it in Settings, then record again.")
+            return
+        }
+        guard let folder = MediaLibrary.directory("Media/Audio") else {
+            EchoelCrashLog.breadcrumb("mic take: start FAILED - no media folder")
+            lastFailure = String(localized: "The recording could not be saved: no space for media files.")
+            return
+        }
+        let name = MediaLibrary.uniqueName(base: Self.fileBase(at: Date()), ext: "wav", taken: { candidate in
+            FileManager.default.fileExists(atPath: folder.appendingPathComponent(candidate).path)
+        })
+        let url = folder.appendingPathComponent(name, isDirectory: false)
+
+        EchoelCrashLog.breadcrumb("mic take: start 1/3 - claim route")
+        do {
+            try AudioConfiguration.claimRecordRoute(.audioTrack)
+            routeHeld = true
+        } catch {
+            EchoelCrashLog.breadcrumb("mic take: start FAILED - route: \(error.localizedDescription)")
+            try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+            routeHeld = false
+            lastFailure = String(localized: "The microphone could not be opened. Close other apps that use it and record again.")
+            return
+        }
+        EchoelCrashLog.breadcrumb("mic take: start 2/3 - create recorder")
+        guard let made = try? AVAudioRecorder(url: url, settings: Self.settings) else {
+            EchoelCrashLog.breadcrumb("mic take: start FAILED - recorder could not be created")
+            try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+            routeHeld = false
+            lastFailure = String(localized: "The microphone could not be opened. Close other apps that use it and record again.")
+            return
+        }
+        EchoelCrashLog.breadcrumb("mic take: start 3/3 - record")
+        guard made.prepareToRecord(), made.record() else {
+            EchoelCrashLog.breadcrumb("mic take: start FAILED - record() refused")
+            made.stop()
+            try? FileManager.default.removeItem(at: url)
+            try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+            routeHeld = false
+            lastFailure = String(localized: "The microphone could not be opened. Close other apps that use it and record again.")
+            return
+        }
+        recorder = made
+        file = url
+    }
+
+    func stop() async -> (url: URL, seconds: Double)? {
+        guard let running = recorder, let url = file else {
+            // Armed but never recording (cancelled, or `start` failed after `prepare`): nothing
+            // to keep, and the route goes back.
+            if routeHeld {
+                EchoelCrashLog.breadcrumb("mic take: stop SKIPPED - nothing recording, release route")
+                try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+                routeHeld = false
+            }
+            return nil
+        }
+        recorder = nil
+        file = nil
+        EchoelCrashLog.breadcrumb("mic take: stop 1/2 - stop recorder")
+        running.stop()
+        EchoelCrashLog.breadcrumb("mic take: stop 2/2 - release route")
+        try? AudioConfiguration.releaseRecordRoute(.audioTrack)
+        routeHeld = false
+        // The length is the FILE's, not the recorder's clock: what lands is what was written.
+        guard let written = try? AVAudioFile(forReading: url),
+              written.fileFormat.sampleRate > 0
+        else {
+            try? FileManager.default.removeItem(at: url)
+            lastFailure = String(localized: "The microphone recorded nothing, so no audio part was added.")
+            return nil
+        }
+        let seconds = Double(written.length) / written.fileFormat.sampleRate
+        guard seconds.isFinite, seconds > 0.05 else {
+            try? FileManager.default.removeItem(at: url)
+            lastFailure = String(localized: "The microphone recorded nothing, so no audio part was added.")
+            return nil
+        }
+        return (url: url, seconds: seconds)
+    }
+}
+#endif
