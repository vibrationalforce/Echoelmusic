+import Foundation
+import XCTest
+
+final class TheRecordRouteHasOneClaimantTests: XCTestCase {
+
+    private static let config = "Sources/Echoelmusic/Audio/AudioConfiguration.swift"
+    private static let claimant = "Echoelmusic/Audio/MicTakeRecorder.swift"
+
+    /// Claim 1 — the route is claimed and released by ONE file, and every call names the one
+    /// owner. A second claimant is legal (#364), but it must arrive with its own case and its
+    /// own pairing, which is a decision this message makes visible instead of silent.
+    func testOnlyTheMicrophoneRecorderClaimsTheRecordRoute() throws {
+        let files = try Self.sourceFiles()
+        XCTAssertGreaterThan(files.count, 100, "ANCHOR MISSING: could not walk `Sources/` (#454, #926).")
+        var callers: [String] = []
+        for (rel, code) in files where !rel.hasSuffix("Audio/AudioConfiguration.swift") {
+            if code.contains("claimRecordRoute(") || code.contains("releaseRecordRoute(") {
+                callers.append(rel)
+            }
+        }
+        XCTAssertEqual(callers.sorted(), [Self.claimant],
+            "The record route has a different set of callers than `MicTakeRecorder` alone (E10-1). "
+            + "A new claimant needs its own `RecordRouteOwner` case, a release on every exit, and "
+            + "the prose in `AudioConfiguration.swift` and CLAUDE.md's audio-input paragraph moved "
+            + "in the same commit. Measure: `git grep -n \"claimRecordRoute(\\|releaseRecordRoute(\" -- Sources`.")
+        guard let code = files.first(where: { $0.0 == Self.claimant })?.1 else { return }
+        for name in ["claimRecordRoute(", "releaseRecordRoute("] {
+            let all = code.components(separatedBy: name).count - 1
+            let named = code.components(separatedBy: name + ".audioTrack)").count - 1
+            XCTAssertGreaterThan(all, 0, "`MicTakeRecorder` no longer calls `\(name)` at all.")
+            XCTAssertEqual(all, named, "a `\(name)` call in `MicTakeRecorder` names another owner than `.audioTrack`.")
+        }
+    }
+
+    /// Claim 2 — the machinery is kept, with exactly the one case E10-1 added. Without this,
+    /// claim 1 is green on a tree that deleted the route handling outright (#299).
+    func testTheMachineryHasExactlyTheOneCase() throws {
+        let code = SourceText.codeOnly(try Self.text(Self.config))
+        let anchor = "enum RecordRouteOwner: Hashable, CaseIterable, Sendable {"
+        let start = try XCTUnwrap(code.range(of: anchor), "ANCHOR MISSING: the owner enum (#408).")
+        let rest = code[start.upperBound...]
+        let end = try XCTUnwrap(rest.firstIndex(of: "}"), "ANCHOR MISSING: the owner enum's closing brace.")
+        let cases = rest[..<end].split(separator: "\n")
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { $0.hasPrefix("case ") }
+        XCTAssertEqual(cases, ["case audioTrack"],
+                       "the owner enum's cases changed. A case is a claimant — see claim 1's message.")
+        XCTAssertTrue(code.contains("static func claimRecordRoute("),
+                      "`claimRecordRoute` was deleted — the answer to #299 went with it.")
+        XCTAssertTrue(code.contains("static func releaseRecordRoute("),
+                      "`releaseRecordRoute` was deleted — same argument.")
+    }
+
+    /// Claim 3 — unchanged from #1336: the two sentences about the deleted two-owner shape stay
+    /// in the past tense. Read RAW, not through `codeOnly`: these are comments (#926).
+    func testTheProseNoLongerClaimsALiveRoute() throws {
+        let raw = try Self.text(Self.config)
+        XCTAssertFalse(
+            raw.contains("is reachable today: voice capture"),
+            "`AudioConfiguration` claims the two-owner breadcrumb is reachable today. Both "
+            + "features it names — `microphoneManager` and input monitoring — are deleted "
+            + "files; E10-1 brought back ONE owner, not two. (Safe as a NEGATIVE scan: the "
+            + "#1336 retraction quotes the struck phrase in CAPITALS — the #491 trap.)")
+        XCTAssertTrue(
+            raw.contains("could run while input monitoring holds the route"),
+            "the past-tense replacement is gone. The sentence is kept, not deleted: it records "
+            + "WHY the breadcrumb exists, which is what a second recorder will need.")
+    }
+
+    // MARK: - Helpers
+
+    private static func sourceFiles() throws -> [(String, String)] {
+        let sources = Self.root().appendingPathComponent("Sources")
+        guard let walker = FileManager.default.enumerator(atPath: sources.path) else { return [] }
+        var out: [(String, String)] = []
+        for case let relative as String in walker where relative.hasSuffix(".swift") {
+            if let body = try? String(contentsOf: sources.appendingPathComponent(relative),
+                                      encoding: .utf8) {
+                out.append((relative, SourceText.codeOnly(body)))
+            }
+        }
+        return out
+    }
+
+    private static func root() -> URL {
+        URL(fileURLWithPath: #filePath)
+            .deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+    }
+
+    private static func text(_ relativePath: String) throws -> String {
+        try String(contentsOf: root().appendingPathComponent(relativePath), encoding: .utf8)
+    }
+}
