index 0000000..43e61ec
--- /dev/null
+++ b/Sources/Echoelmusic/Stream/RTMPBroadcastEngine.swift
@@ -0,0 +1,288 @@
+//
+//  RTMPBroadcastEngine.swift
+//  Echoelmusic — Stream
+//
+//  The thin translation between `BroadcastEngine` (this repo's seam) and HaishinKit 2.2.5's
+//  RTMP products (`HaishinKit` + `RTMPHaishinKit`, BSD-3-Clause — acknowledged in
+//  `Resources/ThirdPartyNotices.txt`, which ships in the bundle). Everything above the wire — state, retries, the shared
+//  start time, the master pump, the picture tap — lives in the repo and is tested with a fake
+//  engine; this file only speaks the library's API. Compiled ONLY when the package is linked
+//  (`#if canImport(RTMPHaishinKit)`), so a build without it carries none of this.
+//
+//  ⭐ THE HANDOFF IS BOUNDED HERE. The pump calls `appendAudio` / `appendVideo` on its own queue
+//  and must never wait. Each call is one non-blocking `yield` into an `AsyncStream` whose buffer
+//  keeps the newest `audioQueueDepth` / `videoQueueDepth` items; a stalled network sheds the
+//  oldest item and counts it. ONE consumer task per track feeds the `RTMPStream` actor IN ORDER —
+//  a `Task` per buffer would not keep order, and RTMP timestamps must rise (the library drops a
+//  message whose time is not later than the last one).
+//
+//  ⭐ ONE CLOCK. Audio is handed over as `AVAudioTime(hostTime:)` and video as a presentation
+//  time on the host clock (`CMClockMakeHostTimeFromSystemUnits`). Both come from the same
+//  `mach_absolute_time` the pump stamped, and both tracks start at the shared `T0`
+//  (`BroadcastStartGate`), so the receiver sees them aligned from the first message.
+//
+//  ⚠️ THE STREAM KEY IS ONLY EVER THE PUBLISH NAME. It is passed to `RTMPStream.publish(_:)` and
+//  nowhere else; nothing here logs it, and the os_log lines below carry state words only.
+//  ⚠️ AND THE LIBRARY'S OWN LOG IS SILENCED, because it is not ours to vouch for: Logboard's
+//  default `ConsoleAppender` `print`s at `.info` and above, and `RTMPStream` logs every server
+//  command it does not handle at `.info` (2.2.5, `RTMPStream.swift:579`) — an `onFCPublish`
+//  answer echoes the publish name, i.e. the key. `.error` lines print `RTMPResponse`s, which can
+//  carry a status description naming the stream too. A level cannot reach below `.error`, so the
+//  appender is replaced with one that writes nothing, once, before any connection exists.
+//
+//  ⚠️ NO CAMERA, NO MICROPHONE. The library's capture mixer is not used — the stream is fed the
+//  master mix and the rendered visual directly, so the rPPG camera and the record route are
+//  untouched by streaming.
+//
+//  ⚠️ KNOWN LIMIT, stated rather than hidden: when the network stalls long enough for the audio
+//  handoff to shed a chunk, the encoder's sample timeline closes the gap, so the sound runs ahead
+//  of the picture by the shed amount for the rest of the stream. The drop is counted
+//  (`droppedAudioChunks`); it needs a stall of ~1 s before it can happen at all.
+//
+
+#if canImport(RTMPHaishinKit) && canImport(AVFoundation) && canImport(Metal) && canImport(CoreVideo)
+import AVFoundation
+import CoreMedia
+import CoreVideo
+import Foundation
+import HaishinKit
+import Logboard
+import os.log
+import RTMPHaishinKit
+
+/// One stream picture and the host time it plays at.
+struct RTMPVideoItem: Sendable {
+    let frame: BroadcastVideoFrame
+    let stampTicks: UInt64
+}
+
+/// The pump-facing sink: two bounded, non-blocking handoffs. Never touches the network.
+final class RTMPMediaSink: BroadcastMediaSink, @unchecked Sendable {
+
+    private let audio: AsyncStream<BroadcastAudioChunk>.Continuation
+    private let video: AsyncStream<RTMPVideoItem>.Continuation
+    private let lock = NSLock()
+    private var shedAudio = 0
+    private var shedVideo = 0
+
+    init(audio: AsyncStream<BroadcastAudioChunk>.Continuation,
+         video: AsyncStream<RTMPVideoItem>.Continuation) {
+        self.audio = audio
+        self.video = video
+    }
+
+    func appendAudio(_ chunk: BroadcastAudioChunk) {
+        if case .dropped = audio.yield(chunk) {
+            lock.withLock { shedAudio += 1 }
+        }
+    }
+
+    func appendVideo(_ frame: BroadcastVideoFrame, stampTicks: UInt64) {
+        if case .dropped = video.yield(RTMPVideoItem(frame: frame, stampTicks: stampTicks)) {
+            lock.withLock { shedVideo += 1 }
+        }
+    }
+
+    var droppedAudioChunks: Int { lock.withLock { shedAudio } }
+    var droppedVideoFrames: Int { lock.withLock { shedVideo } }
+
+    func finish() {
+        audio.finish()
+        video.finish()
+    }
+}
+
+/// Writes nothing. The library's messages may carry the stream key (see the file header).
+private struct SilentLogAppender: LBLoggerAppender {
+    func append(_ logboard: LBLogger, level: LBLogger.Level, message: [Any],
+                file: StaticString, function: StaticString, line: Int) {}
+    func append(_ logboard: LBLogger, level: LBLogger.Level, format: String, arguments: any CVarArg,
+                file: StaticString, function: StaticString, line: Int) {}
+}
+
+final class RTMPBroadcastEngine: BroadcastEngine, @unchecked Sendable {
+
+    private static let log = OSLog(subsystem: "com.echoelmusic", category: "broadcast")
+
+    /// ~1 s of master audio at 1024-frame chunks and 48 kHz.
+    static let audioQueueDepth = 48
+    /// A few pictures; a stalled encoder sheds pictures, never memory.
+    static let videoQueueDepth = 3
+
+    /// Replaces the library loggers' appender with a silent one; runs once per process.
+    private static let libraryLogSilenced: Void = {
+        LBLogger.with(kHaishinKitIdentifier).appender = SilentLogAppender()
+        LBLogger.with(kRTMPHaishinKitIdentifier).appender = SilentLogAppender()
+    }()
+
+    init() {
+        _ = Self.libraryLogSilenced
+    }
+
+    private let lock = NSLock()
+    private var connection: RTMPConnection?
+    private var stream: RTMPStream?
+    private var sink: RTMPMediaSink?
+    private var tasks: [Task<Void, Never>] = []
+    private var lostHandler: (@Sendable () -> Void)?
+    /// Bumped by every `start` and `stop`; a status event from an older connection is ignored.
+    private var generation = 0
+
+    func setConnectionLostHandler(_ handler: @escaping @Sendable () -> Void) {
+        lock.withLock { lostHandler = handler }
+    }
+
+    func start(url: String, streamName: String,
+               settings: BroadcastEncodeSettings) async throws -> BroadcastMediaSink {
+        await stop()
+        let token = lock.withLock { () -> Int in generation += 1; return generation }
+
+        let connection = RTMPConnection()
+        let stream = RTMPStream(connection: connection)
+        do {
+            try await stream.setAudioSettings(AudioCodecSettings(
+                bitRate: settings.audioBitRate,
+                downmix: false,
+                sampleRate: settings.audioSampleRate))
+            try await stream.setVideoSettings(VideoCodecSettings(
+                videoSize: CGSize(width: settings.video.width, height: settings.video.height),
+                bitRate: settings.videoBitRate,
+                maxKeyFrameIntervalDuration: Int32(settings.keyFrameIntervalSeconds),
+                expectedFrameRate: settings.video.framesPerSecond))
+        } catch {
+            os_log(.error, log: Self.log, "Broadcast encoder settings were refused")
+            throw BroadcastEngineError.connectFailed
+        }
+
+        // Subscribe BEFORE connecting: the library replaces its status continuation on every
+        // read of `status`, and a drop that happens before the read would otherwise be lost.
+        let statusEvents = await connection.status
+        let monitor = Task { [weak self] in
+            for await status in statusEvents {
+                switch status.code {
+                case RTMPConnection.Code.connectClosed.rawValue,
+                     RTMPConnection.Code.connectFailed.rawValue,
+                     RTMPConnection.Code.connectIdleTimeOut.rawValue,
+                     RTMPConnection.Code.connectAppshutdown.rawValue:
+                    self?.connectionDropped(token: token)
+                default:
+                    break
+                }
+            }
+        }
+
+        do {
+            _ = try await connection.connect(url)
+        } catch {
+            monitor.cancel()
+            try? await connection.close()
+            os_log(.info, log: Self.log, "Broadcast connect failed")
+            throw BroadcastEngineError.connectFailed
+        }
+        do {
+            _ = try await stream.publish(streamName)
+        } catch {
+            monitor.cancel()
+            try? await connection.close()
+            os_log(.info, log: Self.log, "Broadcast publish was refused")
+            throw BroadcastEngineError.publishRejected
+        }
+
+        let (audioStream, audioIn) = AsyncStream<BroadcastAudioChunk>.makeStream(
+            bufferingPolicy: .bufferingNewest(Self.audioQueueDepth))
+        let (videoStream, videoIn) = AsyncStream<RTMPVideoItem>.makeStream(
+            bufferingPolicy: .bufferingNewest(Self.videoQueueDepth))
+        let sink = RTMPMediaSink(audio: audioIn, video: videoIn)
+
+        let audioTask = Task {
+            for await chunk in audioStream {
+                nonisolated(unsafe) let buffer = chunk.buffer
+                nonisolated(unsafe) let when = AVAudioTime(hostTime: chunk.hostTicks)
+                await stream.append(buffer, when: when)
+            }
+        }
+        let videoTask = Task {
+            var format: CMVideoFormatDescription?
+            for await item in videoStream {
+                guard let sample = Self.sampleBuffer(for: item, format: &format) else { continue }
+                nonisolated(unsafe) let unsafeSample = sample
+                await stream.append(unsafeSample)
+            }
+        }
+
+        let stale = lock.withLock { () -> Bool in
+            guard token == generation else { return true }
+            self.connection = connection
+            self.stream = stream
+            self.sink = sink
+            self.tasks = [monitor, audioTask, videoTask]
+            return false
+        }
+        if stale {
+            // A `stop` arrived while connecting: tear down what was just opened.
+            sink.finish()
+            [monitor, audioTask, videoTask].forEach { $0.cancel() }
+            _ = try? await stream.close()
+            try? await connection.close()
+            throw BroadcastEngineError.connectFailed
+        }
+        os_log(.info, log: Self.log, "Broadcast publishing")
+        return sink
+    }
+
+    func stop() async {
+        let (connection, stream, sink, tasks) = lock.withLock {
+            generation += 1
+            let parts = (self.connection, self.stream, self.sink, self.tasks)
+            self.connection = nil
+            self.stream = nil
+            self.sink = nil
+            self.tasks = []
+            return parts
+        }
+        sink?.finish()
+        tasks.forEach { $0.cancel() }
+        if let stream { _ = try? await stream.close() }
+        if let connection { try? await connection.close() }
+    }
+
+    private func connectionDropped(token: Int) {
+        let handler: (@Sendable () -> Void)? = lock.withLock {
+            guard token == generation, connection != nil else { return nil }
+            return lostHandler
+        }
+        guard let handler else { return }
+        os_log(.info, log: Self.log, "Broadcast connection lost")
+        handler()
+    }
+
+    /// Wraps a rendered picture as an uncompressed sample buffer on the host clock. The format
+    /// description is reused while the picture size stays the same.
+    private static func sampleBuffer(for item: RTMPVideoItem,
+                                     format: inout CMVideoFormatDescription?) -> CMSampleBuffer? {
+        let pixelBuffer = item.frame.pixelBuffer
+        if let current = format,
+           !CMVideoFormatDescriptionMatchesImageBuffer(current, imageBuffer: pixelBuffer) {
+            format = nil
+        }
+        if format == nil {
+            var made: CMVideoFormatDescription?
+            guard CMVideoFormatDescriptionCreateForImageBuffer(
+                allocator: kCFAllocatorDefault, imageBuffer: pixelBuffer,
+                formatDescriptionOut: &made) == noErr else { return nil }
+            format = made
+        }
+        guard let format else { return nil }
+        var timing = CMSampleTimingInfo(
+            duration: .invalid,
+            presentationTimeStamp: CMClockMakeHostTimeFromSystemUnits(item.stampTicks),
+            decodeTimeStamp: .invalid)
+        var sample: CMSampleBuffer?
+        guard CMSampleBufferCreateReadyWithImageBuffer(
+            allocator: kCFAllocatorDefault, imageBuffer: pixelBuffer,
+            formatDescription: format, sampleTiming: &timing,
+            sampleBufferOut: &sample) == noErr else { return nil }
+        return sample
+    }
+}
+#endif
