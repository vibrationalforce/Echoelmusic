{
  "mcpServers": {
    "perplexity": {
      "type": "http",
      "url": "https://mcp.perplexity.com/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://api.firecrawl.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${FIRECRAWL_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83"
      ],
      "env": {}
    },
    "ios-simulator": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "ios-simulator-mcp@2.1.0"
      ],
      "_comment": "Pinned to an exact version (audit 2026-10-08). Bump deliberately, never @latest."
    }
  }
}
