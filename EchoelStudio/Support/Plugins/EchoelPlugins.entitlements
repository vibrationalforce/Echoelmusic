<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one shared container (2026-10-19, factory job 002). The extension only READS the
	     plugin purchase the app recorded here (PluginUnlock.recordedOwned): extensions may not
	     sell (App Review 4.4) and Apple does not support StoreKit inside them. Whether Apple's
	     profile for com.echoelmusic.app.auv3 grants this group is not settled (F17 in
	     docs/dev/FOUNDER_INBOX.md): a missing group can fail signing, or sign and fail later in the
	     host with -3000 as the legacy extension did. If the plugins return -3000 in AUM, remove
	     this key first (factory job 002, criterion 6). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.echoelmusic.shared</string>
	</array>
</dict>
</plist>
