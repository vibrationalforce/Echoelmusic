<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one shared container (2026-10-19, factory job 002). The extension only READS the
	     plugin purchase the app recorded here (PluginUnlock.recordedOwned): extensions may not
	     sell (App Review 4.4) and Apple does not support StoreKit inside them. Apple's profile for
	     com.echoelmusic.app.auv3 carries this group (F17 in docs/dev/FOUNDER_INBOX.md); if it ever
	     does not, studio-testflight.yml fails at signing and uploads nothing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.echoelmusic.shared</string>
	</array>
</dict>
</plist>
