          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstbeobachtung, keine Diagnose"
          }
        }
      }
    },
    "What Echoelmusic’s biofeedback is — and is not." : {
      "comment" : "Learn / guide cards, the six Learn headings and the bio disclaimer (E4-23, 2026-09-30).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
