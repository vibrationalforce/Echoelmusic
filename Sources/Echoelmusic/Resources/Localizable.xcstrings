{
  "sourceLanguage" : "en",
  "strings" : {
    "Decimal separator" : {
      "comment" : "VoiceOver label for the decimal key on the Echoel number pad. Its visible glyph is the reader's own separator, which VoiceOver announces as a punctuation name or, for U+066B, often not at all.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decimal separator"
          }
        }
      }
    },
    "Make negative" : {
      "comment" : "VoiceOver label for the − key on the Echoel number pad. It sets the SIGN of the value being entered and never changes the magnitude; without this label SwiftUI names the button after its SF Symbol (\"minus\"), i.e. the word for the arithmetic the key does not do.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make negative"
          }
        }
      }
    },
    "Make positive" : {
      "comment" : "VoiceOver label for the + key on the Echoel number pad. It sets the SIGN of the value being entered and never changes the magnitude; without this label SwiftUI names the button after its SF Symbol (\"plus\"), i.e. the word for the arithmetic the key does not do.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make positive"
          }
        }
      }
    },
    "Open, save, Live Colabo, Learn and the guide" : {
      "comment" : "DAW shell S3 (2026-10-02, inbox E18): the ≡ menu's spoken hint — it holds Open, Save, Live Colabo, Learn and the Guide switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open, save, Live Colabo, Learn and the guide"
          }
        }
      }
    },
    "Nothing to save yet. Press Play to compose a loop, or add a part to the piece, then save." : {
      "comment" : "DAW shell S3 (2026-10-02): the Save alert's message when there is neither a composed loop nor a part of the user's own — the #622 gate, asked when Save is tapped in the ≡ menu.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to save yet. Press Play to compose a loop, or add a part to the piece, then save."
          }
        }
      }
    },
    "OK" : {
      "comment" : "DAW shell S3: the only button of the Save alert when there is nothing to save.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "Press Play to start — a fingertip on the camera light, or a Bluetooth strap, lets your body drive the sound. Export to your DAW." : {
      "comment" : "Onboarding, page 3 body (#618: names Play, camera light, strap — the first act). Replaced the 'Breathe, lock a key…' key; its orphaned entry left with it (#618b).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Play to start — a fingertip on the camera light, or a Bluetooth strap, lets your body drive the sound. Export to your DAW."
          }
        }
      }
    },
    "Bio-reactive generative loops in any key and BPM — composed by your heart and breath, exported to your DAW." : {
      "comment" : "Onboarding, page 1 body. 'Bio-reactive' is brand vocabulary and stays.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bio-reactive generative loops in any key and BPM — composed by your heart and breath, exported to your DAW."
          }
        }
      }
    },
    "Continue" : {
