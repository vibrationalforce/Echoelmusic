            "value" : "Jedes Pulsintervall gegen das nächste gezeichnet. Eine breite Wolke entlang der Diagonale bedeutet variable Zeitabstände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each pulse interval drawn against the next one. A wide cloud along the diagonal means variable timing."
          }
        }
      }
    },
