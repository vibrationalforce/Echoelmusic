          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine grobe Wetterabfrage bei jedem Start färbt Klang und Bild. Jeder Einfluss hat seine eigene Stärke — misch ihn hinein oder heraus. Der Körper bleibt der Haupttreiber."
          }
        }
      }
    },
