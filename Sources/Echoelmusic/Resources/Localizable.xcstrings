          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was das Biofeedback von Echoelmusic ist — und was nicht."
          }
        }
      }
    },
    " Bio readings are most accurate from a chest strap; wrist and camera are estimates. Breathing guides are optional and never forced." : {
      "comment" : "Learn / guide cards, the six Learn headings and the bio disclaimer (E4-23, 2026-09-30).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bio readings are most accurate from a chest strap; wrist and camera are estimates. Breathing guides are optional and never forced."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bio-Messwerte sind vom Brustgurt am genauesten; Handgelenk und Kamera sind Schätzungen. Atemführungen sind optional und werden nie erzwungen."
          }
        }
      }
    },
