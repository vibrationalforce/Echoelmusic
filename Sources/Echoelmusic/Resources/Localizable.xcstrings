    " note is lengthened by the sustain pedal." : {
      "comment" : "Workstation redesign B6b-1 (2026-10-01): appended to the MIDI-file import note right after the number 1, when the sustain pedal (CC 64) lengthened exactly one imported note — the pedal is applied to note lengths at import. Leading space: it follows the number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " note is lengthened by the sustain pedal."
          }
        }
      }
    },
    " notes are lengthened by the sustain pedal." : {
      "comment" : "Workstation redesign B6b-1 (2026-10-01): appended to the MIDI-file import note right after a number of 2 or more, when the sustain pedal (CC 64) lengthened that many imported notes — the pedal is applied to note lengths at import. Leading space: it follows the number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " notes are lengthened by the sustain pedal."
          }
        }
      }
    },
    " Pitch bend, pressure and controller changes are not imported." : {
      "comment" : "Workstation redesign B6b-0 (2026-10-01): appended to the MIDI-file import note when a channel with notes in the part moved pitch bend, pressure (aftertouch) or a controller — the import reads these past. The sustain pedal is not among them: it is applied to note lengths (B6b-1). Leading space: it follows the previous sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Pitch bend, pressure and controller changes are not imported."
          }
        }
      }
