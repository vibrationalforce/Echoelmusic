      }
    },
    "Flowing already sits a hair behind on every note, and Laid back adds to it — the two together stop at the row's own ceiling, so above about 0.40 the timing no longer changes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowing already sits a hair behind on every note, and Laid back adds to it — the two together stop at the row's own ceiling, so above about 0.40 the timing no longer changes."
          }
        }
      }
    },
    "Syncopated already leans back on its off-beats, and Laid back adds to it — on those notes the two together stop at the row's ceiling, so above about 0.33 they no longer move." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncopated already leans back on its off-beats, and Laid back adds to it — on those notes the two together stop at the row's ceiling, so above about 0.33 they no longer move."
          }
        }
      }
    },
    "Straight and short, hard on the beat — machine time, with air between the notes for the pulse to be felt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straight and short, hard on the beat — machine time, with air between the notes for the pulse to be felt."
          }
        }
      }
    },
    "Even and long with almost no accent, and the figure rotates a little every bar so it repeats without being repetitive." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even and long with almost no accent, and the figure rotates a little every bar so it repeats without being repetitive."
          }
        }
      }
    },
    "The same notes as Driving but longer, and the level contour moves — the bar breathes. This is where Evolve does the most." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same notes as Driving but longer, and the level contour moves — the bar breathes. This is where Evolve does the most."
          }
        }
      }
    },
    "Fewer notes than Density asks for, only on the beats, held long. Wide." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer notes than Density asks for, only on the beats, held long. Wide."
          }
        }
      }
    },
    "Prefers the cells between the beats and accents them, inverting the weight — the off-beats are the loud ones, and they land a touch late." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefers the cells between the beats and accents them, inverting the weight — the off-beats are the loud ones, and they land a touch late."
          }
        }
      }
