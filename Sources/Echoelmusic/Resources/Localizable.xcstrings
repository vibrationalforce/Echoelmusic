    "For music and self-observation only — not a medical device and not for diagnosis. Readings are approximate; don’t use them for health decisions." : {
      "comment" : "Learn / guide cards, the six Learn headings and the bio disclaimer (E4-23, 2026-09-30).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For music and self-observation only — not a medical device and not for diagnosis. Readings are approximate; don’t use them for health decisions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Musik und Selbstbeobachtung — kein Medizinprodukt und nicht zur Diagnose. Messwerte sind ungefähr; triff damit keine Gesundheitsentscheidungen."
          }
        }
      }
    },
    "Your first three minutes" : {
      "comment" : "Learn / guide cards, the six Learn headings and the bio disclaimer (E4-23, 2026-09-30).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
