<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ============================= -->
    <!-- PRIVACY TRACKING               -->
    <!-- ============================= -->

    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array>
        <!-- No tracking domains -->
    </array>

    <!-- ============================= -->
    <!-- DATA COLLECTION                -->
    <!-- ============================= -->

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- EMPTY on purpose (aligned 2026-07-16 with the ASC privacy label
             "Data Not Collected"): under Apple's definition, "collected" means
             transmitted off-device in a way accessible to the developer or
             partners — which never happens. There are no accounts, no analytics
             SDKs, no crash reporters, no server. Health/bio and audio data are
             processed on-device only; HealthKit-sourced values NEVER leave the
             device (BioEgressPolicy gates the OSC/ADM senders), and the only
             network egress (OSC/ADM/Art-Net/sACN of the app's own camera/BLE
             measurements) is user-initiated to devices the USER chooses — it is
             never available to Echoel. -->
    </array>

    <!-- ============================= -->
    <!-- API ACCESS                     -->
    <!-- ============================= -->

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- User Defaults API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>  <!-- App preference storage -->
                <string>1C8F.1</string>  <!-- App-Group suite shared with own
                                              extensions (BioFeedbackManager:
                                              group.com.echoelmusic → widget; the AUv3
                                              target went 2026-07-24, #1234) -->
            </array>
        </dict>

        <!-- File Timestamp API: NOT declared. The whole dict (C617.1, "accessing files
             created by the user") stood here and is REMOVED (#1307), because its ONE cited
             caller was `.creationDateKey` in `VideoLibraryPanel`, and the founder withdrew
             video capture on 2026-09-12 (#1304) — the file is gone.
             Re-measured over every symbol Apple lists for this category, comments stripped:
               creationDate(Key) · contentModificationDateKey · NSURLCreationDateKey ·
               NSURLContentModificationDateKey · modificationDate · fileModificationDate ·
               NSFileCreationDate · NSFileModificationDate · getattrlist* · stat/fstat/lstat
             → ZERO hits in Sources/. The only survivor is
             `CrashSafeStatePersistence.swift:430`, `attributesOfItem(atPath:)[.size]` — a file
             SIZE, and `attributesOfItem` is not on Apple's list for this category at all.
             ⚠️ THIS IS THE #1234 SHAPE, DELIBERATELY REPEATED: that commit removed the
             DiskSpace dict and the 0A2A.1 reason on the same argument, two days before this
             one, and the builds after it uploaded. A declaration whose reason string names a
             use the app no longer has is an INACCURATE declaration, not a harmless extra.
             ⭐ If a timestamp is ever read again (a take list sorted by date, an export
             pre-flight), re-declare with C617.1 AND add the category back to
             `requiredCategories` in ThePrivacyManifestIsDeclaredForBothTargetsTests — claim 4
             asserts SET EQUALITY, so the two move together or the blocking bundle goes red. -->

        <!-- System Boot Time API -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>

            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>  <!-- Performance measurement -->
            </array>
        </dict>

        <!-- Disk Space API: NOT declared. A DiskSpace dict (E174.1 "display storage to the
             user" + 85F4.1) stood here and is REMOVED (#1234, audit 2026-09-10 `ship-path-6`):
             `git grep -c 'volumeAvailableCapacity\|attributesOfFileSystem\|systemFreeSize\|volumeTotalCapacity' Sources`
             → 0. A declaration without a call site is the mirror image of the #1222 risk.
             If a recorder pre-flight ever checks free space, re-declare with 85F4.1 only. -->
    </array>
</dict>
</plist>
